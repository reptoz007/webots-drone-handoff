EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

WorldInfo {
  info [
    "Cooperative Drone Target Handoff and Visual Servoing Simulation"
    "Real geography: Washington Monument, National Mall, Washington DC (anchor 38.8895 N, -77.0353 W = world origin)"
    "Ground texture: Esri World Imagery satellite tiles (Esri, Maxar, Earthstar Geographics, and the GIS User Community)"
    "3D buildings: OpenStreetMap footprints via Overpass API, (c) OpenStreetMap contributors (ODbL)"
    "Elevation: SRTM via Mapzen/AWS public terrain tiles (terrarium z15)"
  ]
  title "Swarm Target Handoff"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
  coordinateSystem "ENU"
}

